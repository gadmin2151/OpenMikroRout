[Unit]
Description=Recover an interrupted OpenMikroRout update before booting the router console
After=local-fs.target
Before=openmikrorout.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/usr/local/libexec/openmikrorout-maintenance
ExecStart=/usr/local/libexec/openmikrorout-maintenance/.venv/bin/python -m app.update_worker --boot-recover
TimeoutStartSec=120
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/opt /var/lib/openmikrorout /var/backups/openmikrorout

[Install]
WantedBy=multi-user.target
