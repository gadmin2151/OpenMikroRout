[Unit]
Description=OpenMikroRout isolated Fail2ban engine
After=network.target openmikrorout-firewall.service
PartOf=openmikrorout.service

[Service]
Type=simple
WorkingDirectory=/opt/openmikrorout
EnvironmentFile=-/etc/openmikrorout.env
Environment=OMR_DATA_DIR=/var/lib/openmikrorout
Environment=PYTHONNOUSERSITE=1
ExecStart=/opt/openmikrorout/.venv/bin/python -m app.fail2ban_runtime daemon
TimeoutStopSec=15
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET
ReadWritePaths=/var/lib/openmikrorout

[Install]
WantedBy=multi-user.target
