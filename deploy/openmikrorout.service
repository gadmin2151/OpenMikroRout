[Unit]
Description=OpenMikroRout - lightweight Linux router
After=network-online.target openmikrorout-update-recover.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/openmikrorout
EnvironmentFile=/etc/openmikrorout.env
Environment=OMR_MODE=linux
Environment=OMR_DATA_DIR=/var/lib/openmikrorout
ExecStart=/opt/openmikrorout/.venv/bin/python -m uvicorn app.main:create_app --factory --host 127.0.0.1 --port 8088 --workers 1 --no-access-log --no-proxy-headers
Restart=always
RestartSec=2
TimeoutStopSec=90
UMask=0077
StateDirectory=openmikrorout
StateDirectoryMode=0700
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=no
ReadOnlyPaths=/proc/sys
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK AF_PACKET
ReadWritePaths=/var/lib/openmikrorout /run /proc/sys/net/ipv4/ip_forward

[Install]
WantedBy=multi-user.target
