[Unit]
Description=OpenMikroRout - restore confirmed firewall before host networking
DefaultDependencies=no
After=local-fs.target systemd-sysctl.service systemd-modules-load.service
Before=network-pre.target networking.service shutdown.target
Wants=network-pre.target
RequiresMountsFor=/opt/openmikrorout /var/lib/openmikrorout
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/openmikrorout
EnvironmentFile=/etc/openmikrorout.env
Environment=OMR_DATA_DIR=/var/lib/openmikrorout
ExecStart=/opt/openmikrorout/.venv/bin/python -m app.bootstrap
TimeoutStartSec=30
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_UNIX AF_NETLINK
# SQLite mode=ro still needs writable WAL/SHM metadata after a clean shutdown.
ReadWritePaths=/run /var/lib/openmikrorout

[Install]
WantedBy=multi-user.target
