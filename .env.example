# Copy to .env for Docker Compose. Do not commit .env.
OMR_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
OMR_ADMIN_USERNAME=admin
# Optional initial account with read-only access; use a different unique password.
OMR_READ_USERNAME=viewer
OMR_READ_PASSWORD=
# Linux and databases with users always require login. For a new demo use 1 to bootstrap.
OMR_AUTH_ENABLED=0
OMR_ALLOWED_HOSTS=localhost,127.0.0.1
# Set to 1 when accessing the panel through HTTPS.
OMR_SECURE_COOKIE=0

# Passive IPv4 ingress headers (TCP SYN / UDP); payloads are never retained.
OMR_MONITOR_ENABLED=1
# Native Linux/systemd only; requires deploy/install-updater.sh and a pinned public key.
OMR_UPDATES_ENABLED=0
OMR_UPDATE_CONFIG=/etc/openmikrorout-update.json
